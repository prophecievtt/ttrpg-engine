{
  "name": "ttrpg-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless, system-agnostic TTRPG state-machine ecosystem: rules, interactions, grid, spatial, orchestrator",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:invariants": "node scripts/invariants.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:pack": "node scripts/pack-check.mjs",
    "dev:server": "node server.js",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rm -rf node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}