{
  "name": "@ttrpg-engine/interactions",
  "version": "0.1.0",
  "description": "Live-session state machine for TTRPGs: immutable ECS state, intent dispatch, RFC 6902 delta emission, temporal effects, injected-entropy dice. Deterministic by construction.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prophecievtt/ttrpg-engine.git",
    "directory": "packages/interactions"
  },
  "homepage": "https://github.com/prophecievtt/ttrpg-engine/tree/main/packages/interactions#readme",
  "bugs": {
    "url": "https://github.com/prophecievtt/ttrpg-engine/issues"
  },
  "author": "Ethan Reinhardt",
  "keywords": [
    "ttrpg",
    "tabletop",
    "rpg",
    "vtt",
    "headless",
    "state-machine",
    "json-patch",
    "dice",
    "initiative",
    "deterministic"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
