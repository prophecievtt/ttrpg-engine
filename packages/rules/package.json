{
  "name": "@ttrpg-engine/rules",
  "version": "0.1.0",
  "description": "Static knowledge engine for TTRPG systems: compendium indexing, JSON Schema-driven homebrew forms, sandboxed declarative validators.",
  "license": "MIT",
  "author": "Ethan Reinhardt",
  "keywords": [
    "ttrpg",
    "tabletop",
    "rpg",
    "vtt",
    "headless",
    "compendium",
    "json-schema",
    "homebrew",
    "validation"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
