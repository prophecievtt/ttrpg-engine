{
  "name": "@ttrpg-engine/sandbox",
  "version": "0.2.0",
  "description": "Opt-in QuickJS sandbox for author-written JavaScript validators: no file or network access, deterministic step and memory limits. Plugs into @ttrpg-engine/rules as a Validator.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prophecievtt/ttrpg-engine.git",
    "directory": "packages/sandbox"
  },
  "homepage": "https://github.com/prophecievtt/ttrpg-engine/tree/main/packages/sandbox#readme",
  "bugs": {
    "url": "https://github.com/prophecievtt/ttrpg-engine/issues"
  },
  "author": "Ethan Reinhardt",
  "keywords": [
    "ttrpg",
    "tabletop",
    "rpg",
    "vtt",
    "homebrew",
    "validation",
    "sandbox",
    "quickjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ttrpg-engine/rules": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "quickjs-emscripten": "^0.32.0"
  },
  "peerDependencies": {
    "@ttrpg-engine/rules": "^0.1.0"
  }
}
