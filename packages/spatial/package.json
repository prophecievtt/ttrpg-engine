{
  "name": "@ttrpg-engine/spatial",
  "version": "0.2.0",
  "description": "Grid-agnostic 3D geometry for TTRPGs: volumetric shapes, raycasting, collisions, line of sight, lighting. Pure TypeScript, zero dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prophecievtt/ttrpg-engine.git",
    "directory": "packages/spatial"
  },
  "homepage": "https://github.com/prophecievtt/ttrpg-engine/tree/main/packages/spatial#readme",
  "bugs": {
    "url": "https://github.com/prophecievtt/ttrpg-engine/issues"
  },
  "author": "Ethan Reinhardt",
  "keywords": [
    "ttrpg",
    "tabletop",
    "rpg",
    "vtt",
    "headless",
    "geometry",
    "3d",
    "raycast",
    "line-of-sight",
    "lighting"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "lint": "eslint src test bench",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
