{
  "name": "@ttrpg-engine/orchestrator",
  "version": "0.1.0",
  "description": "Glue pipeline for the TTRPG engine ecosystem: rules query → tactical evaluation → entropy binding → interaction dispatch. The fireball vertical slice lives here.",
  "license": "MIT",
  "author": "Ethan Reinhardt",
  "keywords": [
    "ttrpg",
    "tabletop",
    "rpg",
    "vtt",
    "headless",
    "pipeline",
    "spells",
    "multiplayer"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ttrpg-engine/example-ember": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@ttrpg-engine/interactions": "workspace:*",
    "@ttrpg-engine/rules": "workspace:*",
    "@ttrpg-engine/spatial": "workspace:*"
  }
}
